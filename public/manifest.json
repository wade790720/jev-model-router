{
  "manifest_version": 3,
  "name": "__MSG_productName__",
  "default_locale": "en",
  "version": "0.3.2",
  "description": "__MSG_productDescription__",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms", "cookies"],
  "host_permissions": ["https://chatgpt.com/*", "https://api.typesafe.ai/*", "http://127.0.0.1/*", "https://*.skool.com/*", "https://router.tekuei.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "__MSG_productName__",
    "default_popup": "popup.html"
  }
}
