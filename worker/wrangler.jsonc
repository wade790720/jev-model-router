{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jev-model-router",
  "main": "src/skool.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "router.tekuei.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jev-model-router",
      "database_id": "51df88f5-5ee6-4ad3-a475-0ff56d44114d",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["0 3 * * *"] }
}
