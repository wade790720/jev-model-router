{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jev-model-router",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "vars": {
    "STRIPE_PRICE_ID": "REPLACE_WITH_USD_5_MONTHLY_PRICE_ID",
    "MAX_PROMPT_CHARS": "20000",
    "MAX_REQUESTS_PER_MINUTE": "20",
    "MAX_REQUESTS_PER_DAY": "3000",
    "MAX_CHECKOUTS_PER_IP_10_MIN": "5",
    "MAX_INPUT_TOKENS_PER_DAY": "2000000",
    "GLOBAL_INPUT_TOKENS_PER_DAY": "100000000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jev-model-router",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "triggers": { "crons": ["0 3 * * *"] }
}
